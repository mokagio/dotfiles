{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$HOME/.codex/hooks/block-paths.sh\" .a8c-secrets .gnupg .mobile-secrets",
            "timeout": 5,
            "statusMessage": "Checking secret path access"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/log-prompt.sh",
            "timeout": 5,
            "statusMessage": "Logging prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/mokacoding-pty-ltd/engram/hooks/codex-stop.sh",
            "timeout": 30,
            "statusMessage": "Scheduling engram extraction"
          }
        ]
      }
    ]
  }
}
