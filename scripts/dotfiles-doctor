#!/usr/bin/env bash
#
# Check the dotfiles' machine-side health: every managed symlink against
# lib/links.sh (the list setup.sh creates), the environment variables that
# must reach subprocesses, and that gh is authenticated for each GitHub
# credential endpoint the git config wires it up for. Report anything
# missing, mispointed, replaced by a real file, dangling, or unauthenticated.
# Read-only.

DOCTOR_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/links.sh
source "$DOCTOR_DIR/lib/links.sh"

# Environment variables that must be exported and visible to subprocesses —
# some self-set by the dotfiles (zshenv), some expected from machine-local
# config (e.g. ~/.zshrc.local). Each entry is "NAME|kind|description"; kind
# is `dir` (value must be an existing directory) or `any` (just needs a
# value). The doctor runs as a subprocess, so it sees only exported vars — a
# set-but-unexported var reads as unset here, which is exactly the slip this
# catches (e.g. Vim sourcing $DOTFILES_HOME/* with the var unexported).
expected_env_vars=(
  "DOTFILES_HOME|dir|Repo root exported by zshenv; Vim sources \$DOTFILES_HOME/* so it must reach subprocesses"
  "VIMWIKI_HOME|dir|Zettelkasten repo root from machine-local config; enables the ww/tc/wr aliases and Vim wiki"
  "ENGRAM_DIR|dir|Engram memory repo from machine-local config; the cl/cld aliases pass it to claude --plugin-dir"
  "GIO_CC_PLUGINS_HOME|dir|Claude Code plugins root from machine-local config; cl/cld load chief-of-staff from under it"
)

problems=0
warnings=0

# Print a status line (suppressing OK unless DOCTOR_VERBOSE is set). OK is
# clean; WARN is surfaced but non-fatal; anything else is a hard problem.
report() {
  local status=$1 dest=$2 detail=${3:-}
  if [[ "$status" != OK || -n "${DOCTOR_VERBOSE:-}" ]]; then
    printf '%-8s %s%s\n' "$status" "$dest" "${detail:+ $detail}"
  fi
  case "$status" in
    OK) ;;
    WARN) warnings=$((warnings + 1)) ;;
    *) problems=$((problems + 1)) ;;
  esac
  return 0
}

check_link() {
  local src=$1 dest=$2
  if [[ -h "$dest" ]]; then
    if ! link_matches "$dest" "$src"; then
      report WRONG "$dest" "-> $(readlink "$dest") (expected $src)"
    elif [[ -e "$dest" ]]; then
      report OK "$dest"
    else
      report BROKEN "$dest" "-> $(readlink "$dest") (target missing)"
    fi
  elif [[ -e "$dest" ]]; then
    report NOTLINK "$dest" "(real $([[ -d "$dest" ]] && echo dir || echo file), not a symlink)"
    if [[ -f "$dest" && -f "$src" ]]; then
      diff -u "$src" "$dest" 2>/dev/null | sed 's/^/    /' || true
    fi
  else
    report MISSING "$dest" "(expected -> $src)"
  fi
}

check_env() {
  local spec=$1 name kind desc value
  IFS='|' read -r name kind desc <<<"$spec"
  value=${!name:-}
  if [[ -z "$value" ]]; then
    report WARN "\$$name" "unset — $desc"
  elif [[ "$kind" == dir && ! -d "$value" ]]; then
    report WARN "\$$name" "= $value (not a directory) — $desc"
  else
    report OK "\$$name" "= $value"
  fi
}

gh_available() { command -v gh >/dev/null 2>&1; }

# Ask gh for a credential the same way git does. Exits 0 only when gh holds a
# usable token for the host — so it gets gist.github.com (served by the
# github.com token) right, which `gh auth status --hostname` does not. Local,
# no network.
gh_auth_ok() {
  printf 'protocol=https\nhost=%s\n\n' "$1" | gh auth git-credential get >/dev/null 2>&1
}

# Hosts wired to `gh auth git-credential` in the git config. Reads the
# effective config (or $1 if given) with --includes so [include]/[includeIf]
# imports are followed — future endpoints can live in ~/.gitconfig.local.
gh_credential_hosts() {
  local cfg=${1:-} raw
  if [[ -n "$cfg" ]]; then
    raw=$(git config --file "$cfg" --includes --get-regexp '^credential\..*\.helper$' 2>/dev/null) || raw=
  else
    raw=$(git config --includes --get-regexp '^credential\..*\.helper$' 2>/dev/null) || raw=
  fi
  printf '%s\n' "$raw" | { grep -F 'gh auth git-credential' || true; } \
    | sed -E 's/^credential\.(.*)\.helper .*/\1/; s#^https?://##' | sort -u
}

check_gh_auth() {
  local hosts host
  hosts=$(gh_credential_hosts)
  [[ -n "$hosts" ]] || return 0
  if ! gh_available; then
    report WARN "gh" "wired as a git credential helper but not on PATH — install the GitHub CLI"
    return 0
  fi
  while IFS= read -r host; do
    [[ -n "$host" ]] || continue
    if gh_auth_ok "$host"; then
      report OK "gh:$host"
    else
      report WARN "gh:$host" "not authenticated — run: gh auth login"
    fi
  done <<< "$hosts"
}

# iTerm2's prefs live in Dropbox (like Alfred's), loaded at launch via the
# "Load preferences from a custom folder" mechanism. That mechanism is driven
# by two keys in iTerm2's *standard* defaults domain, separate machine state
# setup.sh can't symlink — and iTerm2 silently reverts to the built-in prefs if
# it drifts. This check flags when it isn't pointed at the Dropbox folder.

# True when iTerm2 is installed; skip the check otherwise so machines without
# it aren't nagged (mirrors check_gh_auth only firing when gh is wired).
iterm_installed() { [[ -d /Applications/iTerm.app ]]; }

# Read an iTerm2 default; empty when the key (or the whole domain) is absent.
# Wrapped so tests can stub it without a real iTerm2 install.
iterm_default() { defaults read com.googlecode.iterm2 "$1" 2>/dev/null || true; }

check_iterm_prefs() {
  iterm_installed || return 0
  local expected load folder
  expected="$HOME/Dropbox"
  load=$(iterm_default LoadPrefsFromCustomFolder)
  folder=$(iterm_default PrefsCustomFolder)
  if [[ "$load" != 1 ]]; then
    report WARN "iterm2" "not loading prefs from a custom folder — point it at $expected (iTerm2 → Settings → General → Settings)"
  elif [[ "${folder%/}" != "${expected%/}" ]]; then
    report WARN "iterm2" "loads prefs from ${folder:-<unset>} (expected $expected)"
  else
    report OK "iterm2" "loading prefs from $expected"
  fi
}

[[ "${BASH_SOURCE[0]}" == "${0}" ]] || return 0

set -euo pipefail

echo "Checking managed symlinks…"
emit_links check_link "$DOCTOR_DIR"

echo
echo "Checking expected environment variables…"
for spec in "${expected_env_vars[@]}"; do
  check_env "$spec"
done

echo
echo "Checking GitHub authentication (gh)…"
check_gh_auth

echo
echo "Checking iTerm2 preferences…"
check_iterm_prefs

echo
if [[ "$problems" -gt 0 ]]; then
  printf '%d problem(s) found. Re-run setup.sh after resolving, or fix by hand.\n' "$problems"
fi
if [[ "$warnings" -gt 0 ]]; then
  printf '%d warning(s) — environment or credentials need attention (see above).\n' "$warnings"
fi
if [[ "$problems" -eq 0 && "$warnings" -eq 0 ]]; then
  echo "All checks passed."
fi
[[ "$problems" -eq 0 ]] || exit 1
