#!/usr/bin/env bash

set -eu

# Sweep away branches that have already been merged in the remote.

DEFAULT_MAIN_BRANCH=trunk
MAIN_BRANCH=${1:-$DEFAULT_MAIN_BRANCH}

echo "Deleting all local branches that have been merged into $MAIN_BRANCH..."

git fetch

# Collect branches checked out in worktrees so we can skip them.
worktree_branches=$(git worktree list --porcelain | sed -n 's/^branch refs\/heads\///p')

git branch --merged | grep -E -v "(^\*|$MAIN_BRANCH)" | while read -r branch; do
  if echo "$worktree_branches" | grep -qxF "$branch"; then
    echo "Skipping '$branch' (checked out in a worktree)"
  else
    git branch -d "$branch"
  fi
done
