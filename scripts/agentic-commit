#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: agentic-commit [-C <repo>] [-m <message-file>] [--] <file>...

Stage the listed files and commit with the given message.

Options:
  -C <repo>          Repository path (default: cwd)
  -m <message-file>  Path to file containing the commit message

If -m is omitted, the message is read from stdin.

On success, prints: <short-hash> <title-line>
On failure, prints git errors to stderr and exits with the original code.
EOF
  exit 2
}

repo=""
message_file=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -C)
      [[ $# -lt 2 ]] && usage
      repo="$2"
      shift 2
      ;;
    -m)
      [[ $# -lt 2 ]] && usage
      message_file="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -eq 0 ]]; then
  echo "error: no files to stage" >&2
  usage
fi

if [[ -z "$message_file" ]]; then
  # Read message from stdin
  message_file="$(mktemp)"
  cat > "$message_file"
  trap 'rm -f "$message_file"' EXIT
  if [[ ! -s "$message_file" ]]; then
    echo "error: empty message from stdin" >&2
    exit 1
  fi
elif [[ ! -f "$message_file" ]]; then
  echo "error: message file not found: $message_file" >&2
  exit 1
fi

git_args=()
if [[ -n "$repo" ]]; then
  git_args+=(-C "$repo")
fi

# Applies the optional `-C <repo>` uniformly. The `[@]+` guard keeps an empty
# git_args from tripping `set -u` on bash 3.2 (pre-4.4) — the system bash on a
# fresh macOS.
git_repo() { git ${git_args[@]+"${git_args[@]}"} "$@"; }

# Files that already have staged hunks are left alone so that partial staging
# (e.g. via `git add -p`) is preserved.  Only unstaged/untracked files get added.
staged_files="$(git_repo diff --cached --name-only)"
for file in "$@"; do
  if ! echo "$staged_files" | grep -qxF "$file"; then
    git_repo add "$file"
  fi
done

git_repo commit -F "$message_file" >/dev/null

git_repo log --oneline -1
