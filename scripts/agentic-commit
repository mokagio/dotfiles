#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: agentic-commit [-C <repo>] [-m <message-file>] [--keep-staged] [--] <file>...

Stage the listed files and commit with the given message.

Options:
  -C <repo>          Repository path (default: cwd)
  -m <message-file>  Path to file containing the commit message
  --keep-staged      Stage nothing; commit exactly what is already in the index.
                     <file>... becomes optional and is ignored for staging.
                     Use for a deliberate `git add -p` partial-authorship commit.

If -m is omitted, the message is read from stdin.

On success, prints: <short-hash> <title-line>
On failure, prints git errors to stderr and exits with the original code.
EOF
  exit 2
}

repo=""
message_file=""
keep_staged=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -C)
      [[ $# -lt 2 ]] && usage
      repo="$2"
      shift 2
      ;;
    -m)
      [[ $# -lt 2 ]] && usage
      message_file="$2"
      shift 2
      ;;
    --keep-staged)
      keep_staged=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -eq 0 && $keep_staged -eq 0 ]]; then
  echo "error: no files to stage" >&2
  usage
fi

if [[ -z "$message_file" ]]; then
  # Read message from stdin
  message_file="$(mktemp)"
  cat > "$message_file"
  trap 'rm -f "$message_file"' EXIT
  if [[ ! -s "$message_file" ]]; then
    echo "error: empty message from stdin" >&2
    exit 1
  fi
elif [[ ! -f "$message_file" ]]; then
  echo "error: message file not found: $message_file" >&2
  exit 1
fi

git_args=()
if [[ -n "$repo" ]]; then
  git_args+=(-C "$repo")
fi

# Applies the optional `-C <repo>` uniformly. The `[@]+` guard keeps an empty
# git_args from tripping `set -u` on bash 3.2 (pre-4.4) — the system bash on a
# fresh macOS.
git_repo() { git ${git_args[@]+"${git_args[@]}"} "$@"; }

# Stage each listed file, then commit. A file is added even when it already has
# staged hunks: a `git mv` rename or a staged-then-edited new file leaves the
# path in the index while later edits sit unstaged, and skipping the add would
# silently drop them.
#
# --keep-staged inverts this — stage nothing and commit exactly what is already
# in the index, for a deliberate `git add -p` / partial-authorship commit.
if [[ $keep_staged -eq 0 ]]; then
  for file in "$@"; do
    git_repo add "$file"
  done
fi

git_repo commit -F "$message_file" >/dev/null

git_repo log --oneline -1
