{
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(bundle exec pod install:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bundle info:*)",
      "Bash(bundle install:*)",
      "Bash(cargo:*)",
      "Bash(command -v:*)",
      "Bash(date:*)",
      "Bash(df:*)",
      "Bash(diff:*)",
      "Bash(du:*)",
      "Bash(file:*)",
      "Bash(ln:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git clone:*)",
      "Bash(git commit:*)",
      "Bash(git config --get:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(git worktree:*)",
      "Bash(make:*)",
      "Bash(man:*)",
      "Bash(mkdir:*)",
      "Bash(pwd:*)",
      "Bash(readelf:*)",
      "Bash(source:*)",
      "Bash(sw_vers:*)",
      "Bash(swift build:*)",
      "Bash(swift package:*)",
      "Bash(swift test:*)",
      "Bash(test:*)",
      "Bash(tree:*)",
      "Bash(type:*)",
      "Bash(uname:*)",
      "Bash(which:*)",
      "Bash(xcbeautify:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun simctl list devices available)",
      "Bash(xcrun xcresulttool:*)",
      "Bash(/opt/homebrew/bin/gh api repos:*)",
      "Bash(/opt/homebrew/bin/gh api search/issues:*)",
      "Bash(/opt/homebrew/bin/gh auth status)",
      "Bash(/opt/homebrew/bin/gh issue list:*)",
      "Bash(/opt/homebrew/bin/gh issue view:*)",
      "Bash(/opt/homebrew/bin/gh label list:*)",
      "Bash(/opt/homebrew/bin/gh pr checks:*)",
      "Bash(/opt/homebrew/bin/gh pr checkout:*)",
      "Bash(/opt/homebrew/bin/gh pr create:*)",
      "Bash(/opt/homebrew/bin/gh pr diff:*)",
      "Bash(/opt/homebrew/bin/gh pr list:*)",
      "Bash(/opt/homebrew/bin/gh pr merge:*)",
      "Bash(/opt/homebrew/bin/gh pr view:*)",
      "Bash(/opt/homebrew/bin/gh run list:*)",
      "Bash(/opt/homebrew/bin/gh run view:*)",
      "Bash(/opt/homebrew/bin/gh release list:*)",
      "Bash(/opt/homebrew/bin/gh release view:*)",
      "Bash(/opt/homebrew/bin/gh repo view:*)",
      "Bash(/opt/homebrew/bin/gh search prs:*)",
      "Edit",
      "Glob",
      "Grep",
      "mcp__say__*",
      "mcp__buildkite__*",
      "Read",
      "Task",
      "WebSearch",
      "WebFetch",
      "Write"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/log-permission-request.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-destructive.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rubocop-post-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/iterm-tab-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/verify-on-stop.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/iterm-tab-reset.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}
