[user]
  name = "Gio Lodi"
  email = "gio@mokacoding.com"
[fetch]
  prune = true
[push]
  default = simple
  autoSetupRemote = true
[diff]
  algorithm = histogram
[core]
  excludesfile = ~/.gitignore
[rebase]
  autosquash = true
  autostash = true
  updateRefs = true
[github]
  user = mokagio
[pull]
  rebase = true
[credential]
  helper = osxkeychain
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  required = true
  process = git-lfs filter-process
[status]
  submoduleSummary = true

# Sign commits with GPG
#
# Note that the `user.signingkey` parameter is expected to be in `~/.gitconfig.local`
# in order to support diffrent keys for differnt Macs.
[commit]
  gpgsign = true
[gpg]
  program = gpg

[alias]
  # I make so many typos... 🙃
  sash = stash
  satsh = stash
  stahs = stash
  sohw = show
  swho = show
  shwo = show
  grpe = grep
  greg = grep

# See http://blog.xk72.com/post/31456986659/diff-strings-files-in-git
[diff "localizablestrings"]
  textconv = "iconv -f utf-16 -t utf-8"
[rerere]
  enabled = true
[column]
  ui = auto
[branch]
  sort = -committerdate
[init]
	defaultBranch = trunk

# See also https://dev.to/absoftware/git-config-user-email-for-repositories-in-subdirectory-140k
# to conditionally include .gitconfig from subfolders, which you'll likely want to do in the .local version
[include]
  path = ~/.gitconfig.local
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
